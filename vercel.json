{
  "rewrites": [
    {
      "source": "/Shop",
      "destination": "/shop.html"
    },
    {
      "source": "/Video",
      "destination": "/video.html"
    },
    {
      "source": "/Contact",
      "destination": "/contact.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/404.html"
    },
    {
      "source": "/AI",
      "destination": "/ai.html"
    }
  ]
}